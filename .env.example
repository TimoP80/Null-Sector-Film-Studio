# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Local Video Generation (Zero-Budget Option) ──────────────────────────
# Enable local video generation via ComfyUI or compatible backend.
# Does NOT require GEMINI_API_KEY — runs entirely on your local GPU.
# Requires a running ComfyUI instance (or compatible backend) with LTX-Video.
# LOCAL_VIDEO_MODEL: LTX-Video checkpoint (diffusion model + VAE) placed in
# ComfyUI's models/checkpoints directory.
# LOCAL_VIDEO_TEXT_ENCODER: T5-XXL text encoder (LTX-Video checkpoints do NOT
# bundle a text encoder) placed in ComfyUI's models/text_encoders directory.
# t5xxl_fp8_e4m3fn.safetensors (~4.9 GB) is the low-VRAM choice.
LOCAL_VIDEO_ENABLED="false"
LOCAL_VIDEO_URL="http://127.0.0.1:8188"
LOCAL_VIDEO_MODEL="ltx-video-2b-v0.9.1.safetensors"
LOCAL_VIDEO_TEXT_ENCODER="t5xxl_fp8_e4m3fn.safetensors"
LOCAL_VIDEO_TIMEOUT_SEC="1500"  # long GPU jobs (LTX image-to-video on 8 GB VRAM) can take 10-20+ min
LOCAL_VIDEO_POLL_INTERVAL_SEC="2"
# LOCAL_VIDEO_OUTPUT_FORMAT="auto"  # webp | mp4 | auto (mp4 uses native CreateVideo→SaveVideo on ComfyUI 0.20.x, or VideoHelperSuite / VHS_VideoCombine)
# LOCAL_VIDEO_WORKFLOW="path/to/custom/workflow.json"  # Optional custom ComfyUI workflow
# ── Modal LTX accelerator (explicit opt-in; not a production endpoint by itself) ──
# MODAL_LTX_ENDPOINT must be a separately deployed, authenticated HTTP adapter.
# The isolated scripts/modal-ltx-benchmark/ benchmark CLI is not invoked by the app.
# MODAL_LTX_ENABLED="false"
# MODAL_LTX_ENDPOINT="https://your-authenticated-modal-adapter.example"
# MODAL_LTX_APP="nullsector-ltx"
# MODAL_LTX_FUNCTION="prepare_and_generate"
# MODAL_LTX_TIMEOUT_SEC="900"
# MODAL_LTX_MAX_COST_USD="1"
# VIDEO_PROVIDER="local"  # local | modal | auto; local remains the safe default

# ── Local Image Generation (Zero-Budget Option) ─────────────────────────
# Enable local image generation via ComfyUI (SD 1.5 / SDXL / Flux checkpoints).
# Does NOT require GEMINI_API_KEY — runs entirely on your local GPU.
# Requires a running ComfyUI instance with at least one image checkpoint.
#
# LOCAL_IMAGE_MODEL: the checkpoint filename ComfyUI reports for it, or "auto" to
# pick the first installed image checkpoint. On a GTX 1070 (8 GB VRAM) an SD 1.5
# family model is recommended (e.g. DreamShaper 8 ~2 GB, or v1-5-pruned-emaonly
# ~2 GB) at 512x512–768x768. Do NOT use a video checkpoint (LTX/Wan) here.
# Set it to the exact filename, e.g. "dreamshaper_8.safetensors".
LOCAL_IMAGE_ENABLED="false"
LOCAL_IMAGE_URL="http://127.0.0.1:8188"
LOCAL_IMAGE_MODEL="auto"
LOCAL_IMAGE_TIMEOUT_SEC="300"
LOCAL_IMAGE_POLL_INTERVAL_SEC="1"
# LOCAL_IMAGE_WORKFLOW="path/to/custom/workflow.json"  # Optional custom ComfyUI workflow

# ── Local Asset Persistence (optional) ─────────────────────────────────────
# Where completed local images/videos are copied so takes survive backend
# output-folder cleanup. Defaults to ./data/assets when unset. The Electron
# desktop build overrides this with its per-user application data directory.
# NULL_SECTOR_ASSET_DIR="./data/assets"
